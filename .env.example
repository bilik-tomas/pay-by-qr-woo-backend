APP_ENV=prod
APP_DEBUG=false
APP_LOG_LEVEL=INFO
API_PORT=8080

API_SIGN_TTL_SECONDS=300
API_HMAC_ALGO=sha256
ADMIN_TOKEN=change_me_admin_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=change_me_session_secret
ADMIN_TURNSTILE_SITE_KEY=
ADMIN_TURNSTILE_SECRET_KEY=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_LICENSE_PER_MINUTE=120
RATE_LIMIT_HARD_BAN_HITS=20
ABUSE_HARD_BAN_THRESHOLD=30

POSTGRES_DB=pbs
POSTGRES_USER=pbs
POSTGRES_PASSWORD=change_me
DB_DSN=postgresql+psycopg://pbs:change_me@db:5432/pbs
REDIS_URL=redis://redis:6379/0

# Comma-separated client entries: client_id:secret
API_CLIENTS=demo_client:demo_secret_change_me
